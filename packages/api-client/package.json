{
  "name": "@urbanpetly/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed fetch client for the UrbanPetly API",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@urbanpetly/shared": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@urbanpetly/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
