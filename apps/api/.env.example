# Copy to .env and fill in. Never commit .env - see docs/02-architecture.md section 8.
# Variables marked (prod) are required when NODE_ENV=production and optional before then.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# Comma separated list of browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
APP_WEB_URL=http://localhost:5173

# Database (prod)
DATABASE_URL=mysql://urbanpetly:urbanpetly@127.0.0.1:3306/urbanpetly

# Auth (prod). Use at least 32 random characters; generate with `openssl rand -base64 48`.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# OTP. `fake` returns a fixed code and is rejected when NODE_ENV=production.
OTP_PROVIDER=fake
OTP_API_URL=
OTP_API_KEY=

# S3-compatible object store
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
MEDIA_PUBLIC_URL=

# Email
SMTP_URL=

# Comma separated phone numbers allowed to sign in to the admin app
ADMIN_PHONE_ALLOWLIST=

# Error tracking (optional)
SENTRY_DSN=
